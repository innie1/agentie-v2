# Agentie model routing
# The UI persists Local / Auto / Powerful mode in workspace/model_routing.json.
# Auto prefers the local model for ordinary work and escalates complex work when
# the configured powerful/cloud provider is available.
AGENTIE_LOCAL_ENABLED=auto
AGENTIE_LOCAL_MODEL=gemma4
AGENTIE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AGENTIE_LOCAL_PROBE_TIMEOUT=0.25
# Optional for local OpenAI-compatible runtimes that require a non-empty key.
# AGENTIE_LOCAL_API_KEY=agentie-local

# Powerful/cloud provider used by Powerful mode and by Auto when escalation is needed.
# Supported: openrouter, gemini
AGENTIE_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openrouter/auto

# Google AI Studio / Gemini API
# Set AGENTIE_PROVIDER=gemini and provide either GEMINI_API_KEY or GOOGLE_API_KEY.
# GEMINI_API_KEY is preferred when both names are present.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API-saver protection. After a real quota/rate-limit response, Agentie pauses
# further calls to that same powerful provider/model for this many seconds instead
# of letting several background agents repeatedly hit an exhausted API.
AGENTIE_PROVIDER_COOLDOWN_SECONDS=90

AGENTIE_APP_URL=http://localhost:8000
PORT=8000

# Agentie Company Computer (QEMU).
# Agentie automatically selects WHPX on Windows, HVF on macOS, or KVM on Linux.
# Automatic QEMU preparation is enabled by default. Set to 0 only for managed installs.
AGENTIE_QEMU_AUTO_INSTALL=1
# Slow software emulation is intentionally off unless the user explicitly opts in.
AGENTIE_QEMU_ALLOW_TCG=0
# Suspend the shared Company Computer after this many idle seconds.
AGENTIE_COMPUTER_IDLE_SECONDS=600
# Optional local-only ports. Change only if another local service already owns them.
AGENTIE_QEMU_VNC_DISPLAY=1
AGENTIE_QEMU_VNC_WEBSOCKET_PORT=5701
AGENTIE_QEMU_DISPLAY_HTTP_PORT=6088
AGENTIE_QEMU_CDP_PORT=9222
AGENTIE_QEMU_QMP_PORT=4444
AGENTIE_QEMU_QGA_PORT=4445

# Local semantic memory / RAG. "auto" uses FastEmbed when available and
# falls back to Agentie's offline hashed-vector retriever if initialization fails.
AGENTIE_EMBEDDING_BACKEND=auto
AGENTIE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: local cost estimates when the provider response does not include cost.
# Values are USD per 1M input/output tokens. Use the exact model id you configure above.
# Example only — replace with the current pricing for your chosen model.
# AGENTIE_MODEL_PRICING_JSON={"provider/model":{"input":0.00,"output":0.00}}

# Optional Supabase integration
SUPABASE_URL=
SUPABASE_KEY=

# Optional Streamable HTTP MCP server
AGENTIE_MCP_URL=
AGENTIE_MCP_TOKEN=
AGENTIE_COMPUTER_BACKEND=qemu
AGENTIE_QEMU_ALLOW_TCG=1

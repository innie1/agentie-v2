# Paid-model provider used only when Agentie's local-first router cannot complete the request.
# Supported: openrouter, gemini
AGENTIE_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openrouter/auto

# Google AI Studio / Gemini API
# Set AGENTIE_PROVIDER=gemini and provide either GEMINI_API_KEY or GOOGLE_API_KEY.
# GEMINI_API_KEY is preferred when both names are present.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API-saver protection. After a real quota/rate-limit response, Agentie pauses
# further calls to that same provider/model for this many seconds instead of
# letting several background agents repeatedly hit an exhausted API.
AGENTIE_PROVIDER_COOLDOWN_SECONDS=90

AGENTIE_APP_URL=http://localhost:8000
PORT=8000

# Local semantic memory / RAG. "auto" uses FastEmbed when available and
# falls back to Agentie's offline hashed-vector retriever if initialization fails.
AGENTIE_EMBEDDING_BACKEND=auto
AGENTIE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: local cost estimates when the provider response does not include cost.
# Values are USD per 1M input/output tokens. Use the exact model id you configure above.
# Example only — replace with the current pricing for your chosen model.
# AGENTIE_MODEL_PRICING_JSON={"provider/model":{"input":0.00,"output":0.00}}

# Optional Supabase integration
SUPABASE_URL=
SUPABASE_KEY=

# Optional Streamable HTTP MCP server
AGENTIE_MCP_URL=
AGENTIE_MCP_TOKEN=
